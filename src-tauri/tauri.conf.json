{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "linux-coworker-ui",
  "version": "0.2.0",
  "identifier": "dev.linuxcoworker.ui",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash -c 'cd \"$(git rev-parse --show-toplevel)\" && bash scripts/prepare-sidecar.sh && bun run build'",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "linux-coworker-ui",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/mcp-linux-control"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
